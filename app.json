{
  "expo": {
    "name": "FunQuiz Academy",
    "slug": "funquiz-academy",
    "scheme": "funquizacademy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icons/icon_coin_score.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C63FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.funquiz.academy"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/icon_coin_score.png",
        "backgroundColor": "#6C63FF"
      },
      "package": "com.funquiz.academy",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ]
  }
}
