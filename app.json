      "bundleIdentifier": "com.funquizacademy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C63FF"
      },
      "package": "com.funquizacademy.app"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
